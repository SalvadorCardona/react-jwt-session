{
  "name": "react-jwt-session",
  "version": "0.1.0",
  "description": "JWT session handling for React: decode the token, read roles, persist the signed-in user, and expose it all through a provider.",
  "keywords": [
    "react",
    "jwt",
    "auth",
    "session",
    "authentication",
    "roles",
    "typescript"
  ],
  "license": "MIT",
  "author": "Salvador Cardona",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SalvadorCardona/react-jwt-session.git"
  },
  "bugs": {
    "url": "https://github.com/SalvadorCardona/react-jwt-session/issues"
  },
  "homepage": "https://github.com/SalvadorCardona/react-jwt-session#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsdown": "^0.15.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "universal-web-storage": "^0.1.0"
  },
  "pnpm": {
    "overrides": {
      "universal-web-storage": "link:../universal-web-storage"
    }
  }
}
